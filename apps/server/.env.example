JWT_SECRET=generate-a-secret-key-here

DISCORD_CLIENT_ID=PASTE_OAUTH2_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=PASTE_OAUTH2_CLIENT_SECRET_HERE

# 本機一般瀏覽器測試用的假登入，正式環境一定要是 false
ALLOW_MOCK_LOGIN=false

# Bot 的 token（Developer Portal → Bot → Reset Token）。讀頻道清單、語音狀態、搬人都靠它
DISCORD_BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# 文字房讀訊息內容要 Message Content（特權 intent）：先在 Developer Portal → Bot 打開，再改成 true。沒打開就設 true，bot 會登不進去
DISCORD_MESSAGE_CONTENT=false

# 「說話中」的氣泡：bot 會進人最多的公開語音頻道聽誰在講話（自己靜音，不會發出聲音）。一個伺服器同時只能進一個語音頻道
DISCORD_VOICE_LISTEN=false

# 照片生成角色用的 Claude API 金鑰（https://platform.claude.com/ → API Keys）。不設的話，換裝畫面會說明只能手動選部件
ANTHROPIC_API_KEY=
